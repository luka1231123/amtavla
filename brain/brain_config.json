{
  "extraction": {
    "model_enabled": true,
    "profile": "default",
    "_note": "Structured (entity, attribute, value) fact extraction. When true, a grammar-constrained LLM pass runs at commit time with the deterministic rule extractor as fallback; when false/absent, rules only (the offline test path)."
  },
  "llm": {
    "model_filename": "Qwen3.5-9B-Q5_K_M.gguf",
    "gpu_layers": 99,
    "context_size": 8192,
    "use_jinja": true,
    "reasoning_mode": "off",
    "max_tokens": 192,
    "structured_output_enabled": true,
    "sampling": {
      "default": {
        "temperature": 0.7,
        "top_p": 0.8
      },
      "thinking": {
        "temperature": 0.6,
        "top_p": 0.95
      }
    },
    "_swap_note": "Qwen3.5-9B Q5_K_M is the active local model. Keep its native Jinja template enabled and server-side thinking disabled for responsive replies."
  },
  "routing": {
    "default_pathway": "planner_full",
    "max_plan_steps": 4,
    "intent_model_enabled": false,
    "intent_model": "default",
    "intent_model_threshold": 1,
    "intent_embedding_enabled": true,
    "intent_low_confidence_fallback": "planner_full",
    "show_sources": true,
    "resolve_followups_enabled": true
  },
  "idle_memory": {
    "enabled": true,
    "idle_seconds": 4.0,
    "poll_seconds": 0.5,
    "min_interval_seconds": 30.0,
    "reminder_tick_seconds": 2.0
  },
  "memory": {
    "db_dir": "brain/db",
    "catalog_db_path": "brain/db/memory_catalog.db",
    "vector_db_path": "brain/db/ltm_vectors.db",
    "embedding_dim": 768,
    "vector_top_k": 5,
    "min_recall_score": 0.35,
    "episodic_ttl_seconds": 604800,
    "episodic_recall_extension_seconds": 172800,
    "episodic_strength_alpha": 0.25,
    "episodic_strength_decay": 0.02,
    "proactive_turn_gap": 8,
    "proactive_seconds_gap": 600,
    "proactive_max_asks": 2,
    "proactive_snooze_seconds": 900,
    "reminder_gap_seconds": 21600,
    "tagging": {
      "min_confidence": 0.3,
      "max_tags_per_item": 6,
      "feedback_reject_penalty": 0.15,
      "feedback_accept_boost": 0.1
    },
    "context": {
      "snapshot_max_age_seconds": 21600,
      "recent_item_window": 25
    }
  },
  "search": {
    "enabled": true,
    "top_k": 3,
    "max_chars": 2200,
    "timeout_seconds": 6
  },
  "reasoning": {
    "enabled": false,
    "min_sources": 2,
    "max_context_chars": 6500
  },
  "local_files": {
    "root": "sandbox"
  },
  "intents": [
    {
      "name": "brain_dump",
      "priority": 120,
      "pathway": "brain_dump_reply",
      "min_score": 1,
      "keywords": [
        "tell me what's in your brain",
        "show all memory",
        "brain dump",
        "brain memory",
        "brain status"
      ],
      "regex": [
        "^(tell me what's in your brain|show all memory|brain dump|brain status|brain memory.*)$"
      ]
    },
    {
      "name": "smalltalk",
      "priority": 100,
      "pathway": "direct_reply",
      "min_score": 2,
      "keywords": [
        "hi",
        "hello",
        "hey",
        "wazzup",
        "sup",
        "yo",
        "howdy",
        "bro",
        "man",
        "thanks",
        "thank you",
        "how are you",
        "what's up"
      ],
      "regex": [
        "^(hi|hello|hey|yo|wazzup|sup|howdy|what'?s up|thanks|thank you)[!. ]*$"
      ]
    },
    {
      "name": "remember",
      "priority": 95,
      "pathway": "remember_reply",
      "min_score": 1,
      "keywords": [
        "remember this",
        "remember that",
        "don't forget",
        "save this",
        "keep this in mind",
        "memorize"
      ],
      "regex": [
        "^\\s*(please\\s+)?(remember|memori[sz]e|note)\\b",
        "\\bremember (this|that)\\b"
      ]
    },
    {
      "name": "reminder",
      "priority": 94,
      "pathway": "reminder_reply",
      "min_score": 1,
      "keywords": [
        "set a reminder",
        "don't let me forget",
        "dont let me forget"
      ],
      "regex": [
        "\\bremind me (to|about|at|in|that|tomorrow|tonight|later|next|this|on)\\b",
        "\\bset an? reminder\\b",
        "\\bdon'?t let me forget\\b"
      ]
    },
    {
      "name": "reminder_question",
      "priority": 93,
      "pathway": "reminder_reply",
      "min_score": 1,
      "keywords": [],
      "regex": [
        "\\b(would|could|can|will) you remind me\\b"
      ]
    },
    {
      "name": "memory_recall",
      "priority": 92,
      "pathway": "memory_recall_reply",
      "min_score": 1,
      "keywords": [
        "where is my car",
        "where did i park",
        "what did i say",
        "what do you know about",
        "what do you remember about",
        "do you remember",
        "remind me",
        "where is it parked",
        "my memory"
      ],
      "regex": [
        "\\b(where (is|did) (my|the) (car|keys|wallet)|where did i park|what did i say|what do you (know|remember) about|do you remember|remind me where)\\b",
        "\\bwhat(?:'s| is) my\\b",
        "\\bwhat (colou?r|size|kind|type|brand) (is|are|was) my\\b",
        "\\bwhere (is|are) my\\b"
      ]
    },
    {
      "name": "creative_helper",
      "priority": 90,
      "pathway": "creative_reply",
      "min_score": 1,
      "keywords": [
        "brainstorm",
        "creative",
        "story",
        "poem",
        "idea",
        "lyrics",
        "name ideas",
        "tagline"
      ],
      "regex": []
    },
    {
      "name": "arithmetic",
      "priority": 89,
      "pathway": "planner_full",
      "min_score": 1,
      "keywords": [],
      "regex": [
        "\\d+(?:\\.\\d+)?\\s*[*x\u00d7+/-]\\s*\\d+(?:\\.\\d+)?",
        "\\b\\d+(?:\\.\\d+)?\\s*(?:percent|%)\\s*of\\s*\\d+",
        "\\bwhat(?:'s| is) \\d+.*(?:times|plus|minus|multiplied by|divided by)\\s*\\d+"
      ]
    },
    {
      "name": "summarize",
      "priority": 88,
      "pathway": "summarize_reply",
      "min_score": 1,
      "keywords": [
        "summarize my notes",
        "summary of my notes",
        "checklist from my notes",
        "make a checklist",
        "recap my notes"
      ],
      "regex": [
        "\\b(summari[sz]e|recap|checklist)\\b.*\\b(my |the )?(notes?|memory|memories|week|day)\\b",
        "\\bmake (me )?a (checklist|summary)\\b"
      ]
    },
    {
      "name": "local_notes",
      "priority": 86,
      "pathway": "notes_reply",
      "min_score": 1,
      "keywords": [
        "list files",
        "list my files",
        "read the file",
        "open the file",
        "find the file"
      ],
      "regex": [
        "\\b(list|show)\\b.*\\bfiles\\b",
        "\\b(read|open|cat)\\b.*\\.(md|txt|py|json|csv|log|yaml|yml|toml)\\b",
        "\\bfind\\b.*\\b(file|note|doc|document)\\b"
      ]
    },
    {
      "name": "research",
      "priority": 84,
      "pathway": "research_reply",
      "min_score": 1,
      "keywords": [
        "research this",
        "deep dive",
        "look into",
        "investigate",
        "research for me"
      ],
      "regex": [
        "\\b(deep dive|research|investigate|look into)\\b.*\\b(on|about|into|for)\\b",
        "\\bdo (some )?research\\b"
      ]
    },
    {
      "name": "web_factual",
      "priority": 70,
      "pathway": "search_then_reply",
      "min_score": 1,
      "keywords": [
        "weather",
        "news",
        "latest",
        "price",
        "order",
        "buy",
        "pizza",
        "restaurants",
        "near me",
        "delivery"
      ],
      "regex": [
        "\\b(weather|forecast|order|buy|near me|nearby)\\b"
      ]
    }
  ]
}